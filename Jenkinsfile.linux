linux_node = "linux_node"  // Node on which build should execute

//Jenkins Pipeline
pipeline {
    agent { label "${linux_node}" }
    environment {
        // BitBucket specific inputs
        source_files = "src"  // directory in which python source files exist
        repo_name = "spf-python-sw"  // BitBucket repository name
        BitBucket_projectName = "DESSPF"  // BitBucket project name

        // Jenkins specific configurations and inputs
        sonar_scanner_toolname_linux = "sonar-scanner-cli-4.6.0.2311-linux"  // Scanner toolname as configured in Jenkins for linux
        sonar_server_instance = "sonar-prod"  // instance name configured on Jenkins
        reports_dir = "reports"  // folder where tests and sca reports will be generated

        // SonarQube specific configurations and inputs
        sonar_projectKey =  "des-spf-python-sw"
        sonar_projectName = "des-spf-python-sw"
        sonar_qualityProfile = "DES-SPF"
        sonar_qualityGate = "des-spf"
        sonar_python_reportPath = "$reports_dir/pytest.xml"
        sonar_python_coverage_reportPath = "$reports_dir/coverage.xml"
        sonar_python_reportPath_html = "$reports_dir/pytest.html"
        sonar_python_coverage_reportPath_html = "$reports_dir/coverage.html"
        sonar_python_pylint_report = "$reports_dir/pylint.xml"

        // SonarQube properties configurations
        sonar_parameters = " -X -Dproject.settings=config/sonarqube/sonar.properties -Dsonar.python.reportPath=$sonar_python_reportPath  -Dsonar.python.coverage.reportPaths=$sonar_python_coverage_reportPath -Dsonar.python.pylint.report=$sonar_python_pylint_report -Dsonar.projectKey=$sonar_projectKey -Dsonar.projectName=$sonar_projectName "
    }
    stages {
        stage('Init') {
            parallel {
                stage('PR') {
                    when { changeRequest() }
                    steps {
                        echo "This is a Pull Request. Passing this information to SonarQube"
                        script {
                            sonar_parameters = sonar_parameters + " -Dsonar.pullrequest.key=$CHANGE_ID -Dsonar.pullrequest.branch=$CHANGE_BRANCH -Dsonar.pullrequest.base=$CHANGE_TARGET "
                        }
                    }
                }
                stage ('Branch'){
                    when { not { changeRequest() } }
                    steps {
                        echo "This is a normal Branch. Passing this information to SonarQube"
                        script {
                            sonar_parameters = sonar_parameters + " -Dsonar.branch.name=$BRANCH_NAME "
                        }
                    }
                }
            }
        }
        stage('Parallel testing') {
            parallel {
                stage('Test and Coverage'){
                    steps {
                        sh "scripts/linux/unittest.sh"
                    }
                }
                stage('Regression Tests'){         // This may be removed from CI
                    steps {
                        sh "scripts/linux/regressiontest.sh"
                    }
                }
            }
        }
        stage('SCA - PyLint'){
            steps {
                sh "scripts/linux/runPylint.sh"
            }
        }
        stage('Archive Test Report'){
            steps {
                script {
                    def zipFileName = 'report.zip'
                    def zipFileExists = fileExists(zipFileName)
                    if (zipFileExists) {
                        // Delete the zip file if it exists
                        sh "rm ${zipFileName}"
                        //Create Archive Test Report
                        zip zipFile: 'report.zip', archive: false , dir: 'reports'
                    }
                }
            }
        }
        stage('Upload Artifacts') {
            steps {
                script{
                    server = Artifactory.server 'Artifactory'  // name configured in Manage Jenkins-> Configuration
                    def copy = """{
                        "files": [
							{
                                "pattern": "report.zip",
                                "target": "gen-des-spf-local/linux/test/",
                                "recursive": "false"
                            }
                        ]}"""
                    server.upload(copy)
                }
            }
        }
        stage ('Configure Sonarqube') {  //setting webhook and Spf quality profile
            steps {
                withSonarQubeEnv(sonar_server_instance) { //creating SQ project, setting SQ to use SPF quality profile & Webhook for fetching quality gate result without manual intervention
                    echo "creating SQ project, setting SQ to use python-des-memsoft-profile quality profile & Webhook for fetching quality gate result without manual intervention"
                    withCredentials([string(credentialsId: 'sonar-community-prod-token', variable: 'SONAR_TOKEN')]) {
                        sh "scripts/linux/runSonarQubeConfig.sh"
                    }
                }
            }
        }
        stage('SCA - SonarQube'){
             environment {
                sonarscanner = tool name: "${sonar_scanner_toolname_linux}"
            }
            steps {
                withSonarQubeEnv ("${sonar_server_instance}") {
                    echo "analyse sonarqube"
                    sh "$sonarscanner/bin/sonar-scanner  $sonar_parameters"
                }
            }
        }
        stage('SonarQube Quality Gate') {
            steps {
                timeout(time: 1, unit: 'HOURS') { // Just in case something goes wrong, pipeline will be killed after a timeout
                    script {
                        def qg = waitForQualityGate abortPipeline: true // Reuse taskId previously collected by withSonarQubeEnv
                        if (qg.status != 'OK') {
                            error "Pipeline aborted due to quality gate failure: ${qg.status}"
                        }
                    }
                }
            }
        }
        stage('Release') {
            when { branch 'master' } 
            stages {
                stage ('Generate Technical Doc'){
                    steps {
                        sh "scripts/linux/runSphinx.sh" // for linux nodes
                    }
                }
            }
        }
    }
    post {
        success {  // this will execute only if current build is passed
            emailext body: '${SCRIPT, template="groovy-html.template"}', //adding inbuilt groovy html template
            recipientProviders: [developers(), brokenBuildSuspects()],
            subject: 'Build was successful for project "$PROJECT_NAME" and branch "$BRANCH_NAME"',mimeType: 'text/html'
        }
        failure {  // this will execute only if current build is failed
            emailext body: '${SCRIPT, template="groovy-html.template"}',
            recipientProviders: [developers(), brokenBuildSuspects()],
            subject: 'Build Failed for project "$PROJECT_NAME" and branch "$BRANCH_NAME"',mimeType: 'text/html'
        }
        fixed {  // this will execute only if current build is success and previous build failed
            emailext body: '${SCRIPT, template="groovy-html.template"}',
            recipientProviders: [developers(), brokenBuildSuspects()],
            subject: 'Build is back to normal state "$PROJECT_NAME" and branch "$BRANCH_NAME"',mimeType: 'text/html'
        }

    }
}

